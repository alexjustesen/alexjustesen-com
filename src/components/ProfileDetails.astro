---
import { profile } from '../data/profile';
---

<p class="mb-2">
  <span class="text-[var(--color-accent)]">{profile.name}</span> &mdash; {profile.role}.
</p>
<p class="mb-3 text-[var(--color-muted)]">{profile.bio}</p>
<ul class="flex flex-wrap gap-x-4 gap-y-1 text-[var(--color-muted)]">
  {profile.socials.map((social) => (
    <li>
      <a
        href={social.url}
        target="_blank"
        rel="noopener noreferrer"
        data-event={`Social: ${social.label}`}
        class="text-[var(--color-accent)] underline-offset-4 hover:underline"
      >
        {social.name}
      </a>
    </li>
  ))}
</ul>
