---
import Layout from '../layouts/Layout.astro';
import Terminal from '../components/Terminal.astro';
import ProfileCard from '../components/ProfileCard.astro';
import { getCollection } from 'astro:content';

export const prerender = true;

const projects = await getCollection('projects');
const sortedProjects = projects.sort((a, b) => b.data.stars - a.data.stars);

const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const apiEndpoints = [
  {
    method: 'GET',
    path: '/api/profile',
    description: 'Returns profile data as a JSON:API document.',
    command: 'curl https://alexjustesen.com/api/profile',
  },
];

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Layout wide>
  <div class="grid gap-x-8 lg:grid-cols-3">
    <aside class="lg:col-span-1">
      <div class="lg:sticky lg:top-16">
        <ProfileCard />
      </div>
    </aside>

    <div class="lg:col-span-2">
      <Terminal prompt="cat hire-me.txt">
    <p class="mb-2">
      Available for contract work through
      <a
        href="https://maltmethod.dev"
        target="_blank"
        rel="noopener noreferrer"
        data-event="Hire Me: Malt Method (inline)"
        class="text-[var(--color-accent)] underline-offset-4 hover:underline"
        >Malt Method Development LLC</a
      >.
    </p>
    <p class="text-[var(--color-muted)]">
      Specializing in the Laravel ecosystem &mdash; web applications for small and medium
      businesses.
    </p>
    <p class="mt-3">
      <a
        href="https://maltmethod.dev"
        target="_blank"
        rel="noopener noreferrer"
        data-event="Hire Me: Malt Method (cta)"
        class="text-[var(--color-accent)] underline-offset-4 hover:underline"
        >maltmethod.dev &rarr;</a
      >
    </p>
  </Terminal>

  <Terminal prompt="ls projects/">
    {
      sortedProjects.length === 0 ? (
        <p class="text-[var(--color-muted)]">No projects to show.</p>
      ) : (
        <ul class="space-y-2">
          {sortedProjects.map((repo) => (
            <li>
              <a
                href={repo.data.url}
                target="_blank"
                rel="noopener noreferrer"
                data-event={`Project: ${repo.data.name}`}
                class="text-[var(--color-accent)] underline-offset-4 hover:underline"
              >
                {repo.data.name}
              </a>
              {repo.data.description && (
                <span class="text-[var(--color-muted)]"> &mdash; {repo.data.description}</span>
              )}
              <div class="text-xs text-[var(--color-muted)]">
                &#9733; {repo.data.stars}
                {repo.data.language && <> &middot; {repo.data.language}</>}
              </div>
            </li>
          ))}
        </ul>
      )
    }
  </Terminal>

  <Terminal prompt="ls blog/ | head -3">
    {
      recentPosts.length === 0 ? (
        <p class="text-[var(--color-muted)]">No posts yet.</p>
      ) : (
        <ul class="space-y-3">
          {recentPosts.map((post) => (
            <li>
              <a
                href={`/blog/${post.id}`}
                data-event={`Post: ${post.data.title}`}
                class="text-[var(--color-accent)] underline-offset-4 hover:underline"
              >
                {post.data.title}
              </a>
              <div class="text-xs text-[var(--color-muted)]">{fmtDate(post.data.pubDate)}</div>
              <p class="text-[var(--color-muted)]">{post.data.description}</p>
            </li>
          ))}
        </ul>
      )
    }
    <p class="mt-4">
      <a
        href="/blog"
        data-event="Nav: Blog index"
        class="text-[var(--color-accent)] underline-offset-4 hover:underline"
        >cd ../blog <span class="text-[var(--color-muted)]">(read all posts)</span> &rarr;</a
        >
      </p>
    </Terminal>

    <Terminal prompt="ls api/">
      <ul class="space-y-5">
        {apiEndpoints.map((endpoint) => (
          <li>
            <div class="mb-2 flex flex-wrap items-baseline gap-x-2">
              <span class="text-xs text-[var(--color-accent)]">{endpoint.method}</span>
              <a
                href={endpoint.path}
                data-event={`API: ${endpoint.path}`}
                class="text-[var(--color-accent)] underline-offset-4 hover:underline"
              >
                {endpoint.path}
              </a>
              <span class="text-[var(--color-muted)]">&mdash; {endpoint.description}</span>
            </div>
            <div class="overflow-hidden rounded-md border border-[var(--color-border)] bg-black/20">
              <div
                class="flex items-center justify-between border-b border-[var(--color-border)] px-3 py-1 text-xs"
              >
                <span class="text-[var(--color-muted)]">curl</span>
                <button
                  type="button"
                  data-copy-command={endpoint.command}
                  aria-label={`Copy curl command for ${endpoint.path}`}
                  class="text-[var(--color-muted)] underline-offset-4 hover:text-[var(--color-accent)] hover:underline"
                >
                  copy
                </button>
              </div>
              <pre class="overflow-x-auto px-3 py-3 text-xs text-[var(--color-muted)]"><code>{endpoint.command}</code></pre>
            </div>
          </li>
        ))}
      </ul>
    </Terminal>
    </div>
  </div>

  <script>
    const copyButtons = document.querySelectorAll<HTMLButtonElement>('[data-copy-command]');

    for (const button of copyButtons) {
      button.addEventListener('click', async () => {
        const command = button.dataset.copyCommand;
        if (!command) return;

        try {
          await navigator.clipboard.writeText(command);
          button.textContent = 'copied';
        } catch {
          button.textContent = 'failed';
        }

        setTimeout(() => (button.textContent = 'copy'), 2000);
      });
    }
  </script>
</Layout>
