---
import Layout from '../../layouts/Layout.astro';
import Terminal from '../../components/Terminal.astro';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const prerender = true;

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
};

const { post } = Astro.props;
const { Content } = await render(post);

const isoDate = post.data.pubDate.toISOString().slice(0, 10);
---

<Layout title={`${post.data.title} — ~/blog`} description={post.data.description}>
  <Terminal prompt={`cat ~/blog/${post.id}.md`}>
    <div class="mb-6 text-xs leading-relaxed text-[var(--color-muted)]">
      <div class="text-[var(--color-accent)]">---</div>
      <div>title: <span class="text-[var(--color-fg)]">{post.data.title}</span></div>
      <div>date: <span class="text-[var(--color-fg)]">{isoDate}</span></div>
      {
        post.data.tags.length > 0 && (
          <div>
            tags: <span class="text-[var(--color-fg)]">[{post.data.tags.join(', ')}]</span>
          </div>
        )
      }
      <div class="text-[var(--color-accent)]">---</div>
    </div>

    <article class="prose-terminal">
      <h1 class="!mt-0">{post.data.title}</h1>
      <Content />
    </article>

    <p class="mt-8 text-xs text-[var(--color-muted)]">
      <span class="text-[var(--color-accent)]">EOF</span>
    </p>
  </Terminal>

  <p class="mt-6 text-sm">
    <a
      href="/blog"
      data-event="Nav: Blog index"
      class="text-[var(--color-accent)] underline-offset-4 hover:underline"
      >cd .. <span class="text-[var(--color-muted)]">(back to all posts)</span> &rarr;</a
    >
  </p>
</Layout>

<style is:global>
  .prose-terminal {
    color: var(--color-fg);
    line-height: 1.75;
    font-size: 0.95rem;
  }
  .prose-terminal > * + * {
    margin-top: 1em;
  }
  .prose-terminal h1,
  .prose-terminal h2,
  .prose-terminal h3 {
    color: var(--color-fg);
    font-weight: 600;
    line-height: 1.3;
    margin-top: 1.8em;
  }
  .prose-terminal h1 {
    font-size: 1.35rem;
    margin-bottom: 0.25em;
  }
  .prose-terminal h2 {
    font-size: 1.15rem;
  }
  .prose-terminal h3 {
    font-size: 1.05rem;
  }
  .prose-terminal h1::before {
    content: '# ';
    color: var(--color-accent);
  }
  .prose-terminal h2::before {
    content: '## ';
    color: var(--color-accent);
  }
  .prose-terminal h3::before {
    content: '### ';
    color: var(--color-accent);
  }
  .prose-terminal p {
    color: var(--color-fg);
  }
  .prose-terminal a {
    color: var(--color-accent);
    text-underline-offset: 4px;
  }
  .prose-terminal a:hover {
    text-decoration: underline;
  }
  .prose-terminal strong {
    color: var(--color-fg);
    font-weight: 600;
  }
  .prose-terminal em {
    color: var(--color-fg);
    font-style: italic;
  }
  .prose-terminal code {
    background-color: rgb(255 255 255 / 0.06);
    padding: 0.1em 0.35em;
    border-radius: 3px;
    font-size: 0.95em;
  }
  .prose-terminal pre {
    background-color: rgb(0 0 0 / 0.4);
    border: 1px solid var(--color-border);
    padding: 0.85em 1em;
    border-radius: 4px;
    overflow-x: auto;
  }
  .prose-terminal pre code {
    background: none;
    padding: 0;
  }
  .prose-terminal ul,
  .prose-terminal ol {
    list-style: none;
    padding-left: 0;
  }
  .prose-terminal ul li,
  .prose-terminal ol li {
    padding-left: 1.25em;
    position: relative;
  }
  .prose-terminal ul li::before {
    content: '-';
    color: var(--color-accent);
    position: absolute;
    left: 0;
  }
  .prose-terminal ol {
    counter-reset: terminal-ol;
  }
  .prose-terminal ol li {
    counter-increment: terminal-ol;
  }
  .prose-terminal ol li::before {
    content: counter(terminal-ol) '.';
    color: var(--color-accent);
    position: absolute;
    left: 0;
  }
  .prose-terminal blockquote {
    border-left: 2px solid var(--color-accent);
    padding-left: 1em;
    color: var(--color-muted);
    font-style: normal;
  }
  .prose-terminal hr {
    border: 0;
    border-top: 1px dashed var(--color-border);
    margin: 2em 0;
  }
</style>
