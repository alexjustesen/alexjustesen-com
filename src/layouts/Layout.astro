---
import { Font } from 'astro:assets';
import { profile } from '../data/profile';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  wide?: boolean;
}

const {
  title = `${profile.name} — ~/`,
  description = `Personal site of ${profile.displayName} — ${profile.role}.`,
  type = 'website',
  publishedTime,
  wide = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(profile.image, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={profile.displayName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={profile.displayName} />
    <meta property="og:image:width" content="640" />
    <meta property="og:image:height" content="640" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={profile.displayName} />
    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-jetbrains-mono" preload />
    <script src="https://cdn.usefathom.com/script.js" data-site="PGXVWVKB" defer is:inline></script>
    <title>{title}</title>
  </head>
  <body class="min-h-screen">
    <main
      class:list={[
        'mx-auto px-4 py-12 sm:px-6 sm:py-16',
        wide ? 'max-w-5xl' : 'max-w-3xl',
      ]}
    >
      <slot />
    </main>
    <script is:inline>
      (function () {
        var host = window.location.hostname;
        document.addEventListener('click', function (e) {
          var link = e.target instanceof Element ? e.target.closest('a[href]') : null;
          if (!link) return;
          var fathom = window.fathom;
          if (!fathom || typeof fathom.trackEvent !== 'function') return;

          var name = link.getAttribute('data-event');
          if (!name) {
            try {
              var url = new URL(link.href, window.location.href);
              if (url.protocol === 'mailto:' || url.protocol === 'tel:') {
                name = url.protocol.replace(':', '') + ': ' + url.pathname;
              } else if (url.hostname && url.hostname !== host) {
                name = 'Outbound: ' + url.hostname;
              } else {
                name = 'Internal: ' + (url.pathname || '/');
              }
            } catch (err) {
              return;
            }
          }
          fathom.trackEvent(name);
        });
      })();
    </script>
  </body>
</html>
